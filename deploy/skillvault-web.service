[Unit]
Description=Skill Vault Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/skill-vault
EnvironmentFile=/etc/skillvault.env
ExecStart=/usr/bin/env skill-vault web
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
