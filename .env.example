# Skill Vault — environment configuration
# Copy to .env and adjust. All variables are optional with sane defaults.

# --- Storage ---
# SQLite database file path
SKILL_VAULT_DB_PATH=./skill_vault.db

# Vector backend: sqlite_vec (default) | pgvector
SKILL_VAULT_VECTOR_BACKEND=sqlite_vec

# pgvector connection string (only used if VECTOR_BACKEND=pgvector)
# SKILL_VAULT_PGVECTOR_DSN=postgresql://user:pass@localhost:5432/skillvault

# --- Embeddings ---
# sentence-transformers model id (384-d all-MiniLM-L6-v2)
SKILL_VAULT_EMBED_MODEL=all-MiniLM-L6-v2

# --- Trust / supply chain ---
# Host policy: allow-list of trust tiers the server may return (comma-separated)
SKILL_VAULT_TRUST_ALLOW=verified,user

# ed25519 private key (base64) for the curator used to sign "verified" skills
# SKILL_VAULT_CURATOR_KEY=

# --- Web ---
SKILL_VAULT_WEB_HOST=0.0.0.0
SKILL_VAULT_WEB_PORT=8000

# --- Seed library ---
SKILL_VAULT_SEED_DIR=./skill_vault/data/skills
